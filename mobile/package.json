{
  "name": "al-furqan-mobile",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/prepare-web.mjs",
    "check": "node scripts/check-mobile.mjs && node scripts/check-native-account.mjs && node scripts/check-offline-downloads.mjs && node scripts/check-offline-metadata.mjs && node scripts/check-audio-client.mjs && node scripts/check-reading-backup.mjs",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "sharp": "0.35.5"
  }
}
